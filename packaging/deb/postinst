#!/bin/sh
# postinst пакета wayswitch: перечитать правила udev, поднять uinput,
# напечатать краткую подсказку по первому запуску.
set -e

case "$1" in
    configure)
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=input --subsystem-match=misc || true
        modprobe uinput || true

        cat <<'EOF'

WaySwitch установлен. Дальше от имени обычного пользователя:
  1. python3 /usr/share/wayswitch/migrate.py
  2. Выйдите из сеанса и войдите снова (правила udev и расширение
     применяются к новому сеансу).
  3. После входа в GNOME: gnome-extensions enable wayswitch@wetoshkin.github.io
  4. systemctl --user restart wayswitch
  5. Откройте WaySwitch из меню приложений — первый запуск проверит
     систему. Подробная проверка: wayswitch doctor
EOF
        ;;
esac

exit 0
