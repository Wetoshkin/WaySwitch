# Build tools only; all shipped dependencies come from dependencies.json.
FROM docker.io/library/ubuntu@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 ca-certificates squashfs-tools binutils && rm -rf /var/lib/apt/lists/*
WORKDIR /source
ENTRYPOINT ["python3", "tools/build_appimage.py"]
