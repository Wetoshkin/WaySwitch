#!/bin/sh
set -eu
APPDIR="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
export WAYSWITCH_PACKAGE=appimage
export PYTHONHOME="$APPDIR/usr"
export PYTHONPATH="$APPDIR/usr/share/wayswitch:$APPDIR/usr/lib/python3/dist-packages"
export PYTHONNOUSERSITE=1
export GI_TYPELIB_PATH="$APPDIR/usr/lib/x86_64-linux-gnu/girepository-1.0"
export GIO_MODULE_DIR="$APPDIR/usr/lib/x86_64-linux-gnu/gio/modules"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Cairo avoids depending on a particular host GL driver shipped with the bundle.
export GSK_RENDERER="${GSK_RENDERER:-cairo}"
export SSL_CERT_FILE="${SSL_CERT_FILE:-$APPDIR/usr/share/wayswitch/ca-certificates.crt}"
export GDK_PIXBUF_MODULEDIR="$APPDIR/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders"
RUNDIR="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/wayswitch-appimage.XXXXXX")"
trap 'rm -f "$RUNDIR/loaders.cache"; rmdir "$RUNDIR"' EXIT HUP INT TERM
export GDK_PIXBUF_MODULE_FILE="$RUNDIR/loaders.cache"
"$APPDIR/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" \
    --library-path "$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib" \
    "$APPDIR/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders" \
    > "$GDK_PIXBUF_MODULE_FILE"
"$APPDIR/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2" \
    --library-path "$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib" \
    "$APPDIR/usr/bin/python3.12" -P -c \
    'from wayswitch.gui.app import main; raise SystemExit(main())' "$@"
