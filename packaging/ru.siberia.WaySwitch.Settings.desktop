[Desktop Entry]
Type=Application
Name=WaySwitch
GenericName=Автоисправление раскладки
Comment=Настройки автоисправления раскладки (ru/en) на Wayland
Exec=wayswitch-gui
Icon=ru.siberia.WaySwitch
Terminal=false
Categories=Settings;
Keywords=раскладка;layout;punto;keyboard;
# Должно совпадать с APP_ID окна (wayswitch/gui/app.py) и с именем этого файла:
# иначе GNOME не связывает запущенное окно с записью и рисует заглушку.
StartupWMClass=ru.siberia.WaySwitch.Settings
