[Unit]
Description=WaySwitch — автоисправление раскладки
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/wayswitch run
Restart=on-failure
RestartSec=3
# Код 3 — второй экземпляр, 4 — в этой среде нечем переключать раскладку:
# перезапуск не поможет.
RestartPreventExitStatus=3 4

[Install]
# graphical-session.target, а не default.target: иначе сервис стартует до
# графической сессии (нет WAYLAND_DISPLAY, ibus-daemon ещё не поднят →
# бэкенд тихо падает на hotkey и авторежим выключен) и при SSH-логине.
WantedBy=graphical-session.target
