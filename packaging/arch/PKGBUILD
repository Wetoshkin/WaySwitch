# Maintainer: Wetoshkin <12889519+Wetoshkin@users.noreply.github.com>
# Пакет для Arch, CachyOS, EndeavourOS, Manjaro. Готов к публикации в AUR;
# собрать локально: cd packaging/arch && makepkg -si
pkgname=wayswitch
epoch=1
pkgver=1.1.2
pkgrel=1
pkgdesc="Fixes words typed in the wrong keyboard layout on Wayland (ru/en)"
arch=('any')
url="https://github.com/Wetoshkin/WaySwitch"
license=('MIT' 'CC-BY-SA-4.0')
depends=('python' 'python-evdev' 'python-gobject' 'gtk4' 'libadwaita' 'libxkbcommon' 'wayland')
optdepends=('gnome-shell: расширение для переключения раскладки в GNOME'
            'gnome-shell-extension-appindicator: значок в верхней панели GNOME'
            'ibus: запасной способ переключения раскладки в GNOME'
            'pipewire: звук при исправлении (pw-play)')
backup=('etc/xdg/autostart/wayswitch-session.desktop')
install=wayswitch.install
# Полный коммит исключает зависимость контрольной суммы от самого PKGBUILD в теге.
_commit=6355dfbb00f0334cc0750c839cfb370f7f054d91
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('61e69ff46863aee857fafb52720ea134f6ed39a9a6220afbe18c0ffc97f0846a')

package() {
    cd "WaySwitch-$_commit"
    bash tools/stage.sh "$pkgdir" /usr/lib/wayswitch
}
